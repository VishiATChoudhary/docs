                    "type": "object",
                    "properties": {
                      "type": { "type": "string" },
                      "url": { "type": "string" },
                      "timestamp": { "type": "number", "description": "Epoch timestamp (converted to number)" },
                      "payload": { "type": "string", "nullable": true, "description": "JSON-stringified payload or null" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
