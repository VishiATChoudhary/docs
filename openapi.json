  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "Session cookie from /api/auth/* endpoints"
      },
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Site API key (ar_...)"
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "k",
        "description": "Site API key passed as query parameter"
      }
    },
    "parameters": {
      "teamSlug": {
        "name": "teamSlug",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "Team URL slug"
      },
      "siteId": {
        "name": "siteId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "Site ID"
      },
      "range": {
        "name": "range",
        "in": "query",
        "schema": { "type": "integer", "default": 24 },
        "description": "Number of hours to include (default: 24)"
      }
    },
    "schemas": {
      "Team": {
        "type": "object",
        "description": "Team as returned by createTeam",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" }
        }
      },
      "TeamWithRole": {
        "type": "object",
        "description": "Team with the authenticated user's membership role (returned by listTeams)",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "role": { "type": "string", "description": "The authenticated user's role in this team" }
        }
      },
      "TeamAuth": {
        "type": "object",
        "description": "Team identity from the teamAuth middleware (returned by getTeam)",
        "properties": {
          "teamId": { "type": "string" },
          "teamSlug": { "type": "string" },
          "memberRole": { "type": "string" }
        }
      },
      "Member": {
        "type": "object",
        "description": "Team membership record with snake_case fields from the database",
        "properties": {
          "id": { "type": "string", "description": "Membership record ID" },
          "role": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "user_id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "image": { "type": "string", "nullable": true }
        }
      },
      "Site": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "domain": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ApiKey": {
        "type": "object",
        "description": "API key metadata with snake_case fields from the database",
        "properties": {
          "id": { "type": "integer", "description": "Auto-incrementing SERIAL ID" },
          "prefix": { "type": "string", "description": "First 10 characters of the key" },
          "label": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "revoked_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Classification": {
        "type": "object",
        "properties": {
          "classification": { "type": "string", "enum": ["human", "bot", "agent"] },
          "probabilities": {
            "type": "object",
            "properties": {
              "human": { "type": "number" },
              "bot": { "type": "number" },
              "agent": { "type": "number" }
            }
          },
          "source": { "type": "string", "enum": ["model", "heuristic"] }
        }
      },
      "OkResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "example": true }
        }
      }
    }
  },
  "tags": [
    { "name": "Teams", "description": "Manage teams and members" },
    { "name": "Sites", "description": "Manage sites and API keys" },
    { "name": "Events", "description": "Event ingestion and tracking pixel" },
    { "name": "Analytics", "description": "Query detection and traffic data (session auth, team-scoped)" },
    { "name": "Data API", "description": "Programmatic access to site analytics via API key" },
    { "name": "Global Admin", "description": "Platform administration (admin role required)" },
    { "name": "Real-Time", "description": "Live event streaming via SSE" },
    { "name": "Health", "description": "Server health and readiness checks" }
  ]
}
